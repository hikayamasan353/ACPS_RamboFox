function README() {
	/*controller

	Create event:
	store surface position using global variables
	create a surface
	End Step event:
	set target surface
	clear it
	reset target
	Draw event:
	set blend mode to bm_dest_color,bm_zero
	draw the surface at set position
	reset blend mode back to normal

	light

	End Step event:
	set target surface
	set blend mode to add
	draw a sprite reducing its x and y by the surface's ones
	reset blend mode back to normal
	reset target

/* end README */
}
