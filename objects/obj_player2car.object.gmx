          <argument>
            <kind>1</kind>
            <string>var is_changed;
is_changed=0
if keyboard_check(ord('S'))
if reverse_switch=0
{is_changed=1
if brake_alpha&lt;1
brake_alpha+=.25
}

if keyboard_check(ord('W'))
if reverse_switch=1
{is_changed=1
if brake_alpha&lt;1
brake_alpha+=.25
}

if is_changed=0
{if brake_alpha&gt;0
brake_alpha-=.25}</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
