        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if spin_divider&gt;1
{spin_divider-=handbrake_loss}
if spin_divider&lt;1
{spin_divider=1}

if keyboard_check(ord('S'))=0
if reverse_var&gt;0{reverse_var-=reverse_loss}

if reverse_var&gt;reverse_topspeed{reverse_var=reverse_topspeed}

if reverse_var&lt;.1

{
if !keyboard_check(ord('S'))
{
reverse_switch=0}
}
if reverse_switch=0
{light_color=c_red
light_alpha=0}
else
{light_color=c_white
light_alpha=.5}



if reverse_switch=1
{light_color=c_white
if keyboard_check(ord('W'))
{light_color=c_red}
light_alpha=.5}

if reverse_switch=0
{light_color=c_red
if keyboard_check(ord('S'))
{light_color=c_red}
light_alpha=0}</string>
          </argument>
        </arguments>
      </action>
